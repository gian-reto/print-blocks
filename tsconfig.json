{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node", "vite/client"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "docs/.vitepress/**/*.ts",
    "eslint.config.js",
    "src",
    "vite.config.ts"
  ]
}
