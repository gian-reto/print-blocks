# Required shared API token. Must be at least 32 characters.
API_TOKEN=change-me-to-at-least-32-characters

# Must match a CUPS printer queue on the host. If not set, CUPS will attempt to use the default printer.
PRINTER_NAME=My_Printer

# HTTP server settings.
HOST=0.0.0.0
PORT=3000

# CUPS client settings.
CUPS_SERVER=/run/cups/cups.sock
PRINT_TIMEOUT_MS=15000 # Max. amount of time to wait for CUPS to accept a print job, in milliseconds.

# Thermal printer rendering settings.
PRINTER_TYPE=epson # Supported printer types are `epson` and `star`. Note: This only affects the encoding of printer commands, so it doesn't have to match the actual printer model. For example, Citizen printers are generally compatible with Epson ESC/POS commands, so `epson` is usually a safe choice.
PRINTER_WIDTH=48
PRINTER_CHARACTER_SET=pc437_usa

# Request validation limits.
MAX_BLOCKS_PER_PRINT_JOB=50
MAX_REQUEST_BODY_BYTES=10485760
MAX_TEXT_CHARS_PER_BLOCK=5000

# Feature toggles.
EXPOSE_DOCS=false
EXPOSE_LLMS_TXT=false
